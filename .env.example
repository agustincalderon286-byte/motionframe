# Keep this file public. Put real values in a local .env file (never commit it).
KIE_API_KEY=
# Required only when a public deployment receives KIE callbacks.
PUBLIC_BASE_URL=
KIE_CALLBACK_SECRET=
STARTING_CREDITS=12
PORT=4173
HOST=127.0.0.1

# User accounts and persistent, per-user credits.
MONGODB_URI=
MONGODB_DB=motionframe
# Generate a random value of at least 32 characters. Keep it private.
SESSION_SECRET=

# Stripe: create the Price objects in Stripe first, then add their price_ IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_STARTER_CREDITS=15
STRIPE_PRICE_CREATOR=
STRIPE_CREATOR_CREDITS=50
